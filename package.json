{
  "name": "planck-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "worker:dev": "npm run build && wrangler dev --ip 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "test": "playwright test",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "wrangler": "4.151.3",
    "@playwright/test": "1.64.1"
  }
}
